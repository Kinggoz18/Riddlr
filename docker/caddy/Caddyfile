:8080 {
  encode gzip
  header {
    X-Frame-Options DENY
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }

  handle /api/* {
    reverse_proxy api:3001
  }

  handle /healthz {
    reverse_proxy api:3001
  }

  handle /readyz {
    reverse_proxy api:3001
  }

  handle {
    reverse_proxy web:80
  }
}
