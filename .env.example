# Copy this file only for native (`pnpm dev`) development. Docker Compose
# with RIDDLR_LOCAL_COMPOSE=true generates volume secrets automatically.
# Production must set RIDDLR_COOKIE_SECRET and RIDDLR_ENCRYPTION_MASTER_KEY.
# RIDDLR_GENERATE_DEV_SECRETS does not enable generation in production.
# Dashboard: see docs/install.md. Default is http://127.0.0.1:8080 on the
# machine that runs Docker.

# RIDDLR_ENV=development
# RIDDLR_LOCAL_COMPOSE=false
# RIDDLR_GENERATE_DEV_SECRETS=false
# RIDDLR_HTTP_HOST=0.0.0.0
# RIDDLR_HTTP_PORT=3001
# RIDDLR_PUBLIC_URL=http://localhost:8080
# RIDDLR_SETUP_ACCESS=loopback
# RIDDLR_HTTP_PUBLISH=127.0.0.1:8080
# Optional published images (Compose). Leave unset to build from the clone.
# RIDDLR_SERVER_IMAGE=ghcr.io/kinggoz18/riddlr-server:latest
# RIDDLR_WEB_IMAGE=ghcr.io/kinggoz18/riddlr-web:latest
# RIDDLR_DATABASE_URL=postgres://riddlr:riddlr@127.0.0.1:5432/riddlr
# RIDDLR_REDIS_URL=redis://127.0.0.1:6379
# 32-byte keys, base64. Required in production. Generated for development or local Compose.
# RIDDLR_COOKIE_SECRET=
# RIDDLR_ENCRYPTION_MASTER_KEY=
# RIDDLR_LOG_LEVEL=info
# RIDDLR_LOG_FORMAT=pretty
# Optional production email. Local Compose uses Mailpit on the internal network.
# Native `pnpm dev` can use Mailpit SMTP or save Resend in Settings.
# RIDDLR_SMTP_URL=smtp://127.0.0.1:1025
# RIDDLR_RESEND_API_KEY=
# RIDDLR_EMAIL_FROM=Riddlr <noreply@localhost>
# SearXNG JSON endpoint used by the bundled adapter. Public origin does not proxy /searxng.
# RIDDLR_SEARXNG_URL=http://127.0.0.1:8080
# Optional previous master key used only during rotation.
# RIDDLR_ENCRYPTION_MASTER_KEY_PREVIOUS=
# RIDDLR_SESSION_ABSOLUTE_HOURS=12
# RIDDLR_SESSION_IDLE_MINUTES=60
# RIDDLR_MAX_SESSIONS=8
# RIDDLR_PAGE_SIZE=50
# RIDDLR_SCAN_EVIDENCE_LIMIT=50
# RIDDLR_ANALYSIS_EVIDENCE_LIMIT=20
# RIDDLR_SCAN_SOURCE_LIMIT=16
# RIDDLR_WORKER_CONCURRENCY=2
# RIDDLR_SCHEDULER_ENABLED=true
# RIDDLR_SCHEDULER_AGENT_LIMIT=16
# CoinGecko asset registry (worker seed). Default top 1000, refresh every 24h.
# RIDDLR_REGISTRY_TOP_N=1000
# RIDDLR_REGISTRY_SEED_INTERVAL_HOURS=24
# Optional SearXNG limiter secret for local Compose.
# SEARXNG_SECRET=

